# Keep secrets, local state and dev artefacts out of the production image.
.env
.env.*
!.env.example
node_modules
vendor
public/build
public/hot
public/storage
storage/app/*
!storage/app/.gitignore
!storage/app/private
!storage/app/public
storage/app/private/*
!storage/app/private/.gitignore
storage/app/public/*
!storage/app/public/.gitignore
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
bootstrap/cache/*.php
tests
.phpunit.cache
docker/dev.Dockerfile
resources/js/actions
resources/js/routes
resources/js/wayfinder
