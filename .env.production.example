# Production variables for compose.prod.yml. Set them in Coolify (Environment Variables), not in a
# file on the server. See docs/runbooks/deploy-coolify.md for how to generate each value.
# Values marked OFFLINE must also be kept on paper / in the school's password manager:
# they are NOT inside the backups.

APP_URL=https://esign.sditbahteranuh.sch.id
APP_KEY=base64:...
DOCUMENT_ENCRYPTION_KEY=base64:...        # OFFLINE
DB_PASSWORD=...

SIGNER_API_TOKEN=...                      # openssl rand -hex 32
SIGNER_HSM_PIN=...                        # OFFLINE
SIGNER_HSM_SO_PIN=...                     # OFFLINE
SIGNER_TOTP_ENCRYPTION_KEY=...            # OFFLINE (openssl rand -base64 32)
SIGNER_SIGN_LOCATION=
# SIGNER_TSA_URL=http://timestamp.digicert.com

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=...
MAIL_PASSWORD=...                         # Google: App Password
MAIL_FROM_ADDRESS=esign@sditbahteranuh.sch.id
AUDIT_ARCHIVE_EMAIL=

BACKUP_AGE_RECIPIENT=age1...              # public key; the private key stays OFFLINE
BACKUP_RCLONE_REMOTE=
# BACKUP_CRON=0 2 * * *
# BACKUP_KEEP_DAYS=14
